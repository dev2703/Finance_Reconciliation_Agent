# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://finance_app:finance_app_dev@127.0.0.1:5433/finance_reconciliation
OBJECT_STORAGE_PATH=.data/objects
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app
MAX_UPLOAD_BYTES=10485760
MAX_INGESTION_ROWS=10000
MAX_INGESTION_SHEETS=20
MAX_INGESTION_ATTEMPTS=3
TENSORMUX_BASE_URL=http://localhost:8080/v1
TENSORMUX_API_KEY=replace-me
TENSORMUX_MODEL=glm-4.7-flash
TENSORMUX_TIMEOUT_SECONDS=30
TENSORMUX_MAX_RETRIES=2
TENSORMUX_INPUT_COST_PER_MILLION=0
TENSORMUX_OUTPUT_COST_PER_MILLION=0
# Keep all TENSORMUX_* values on the Python service. Never expose them as NEXT_PUBLIC_*.
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_TIMEOUT_SECONDS=20
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_SECONDS=20
